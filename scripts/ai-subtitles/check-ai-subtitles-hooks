#!/usr/bin/env bash
# Run inside a checked-out, isolated target-repository worktree, not on another agent's tree.
set -euo pipefail
cd "$(dirname "$0")/../.."
SIDE="app/src/main/java/com/nuvio/tv/ui/screens/player/PlayerSidecarSubtitles.kt"
FORK="app/src/main/java/com/nuvio/tv/fork/ForkHooks.kt"
[[ -f "$SIDE" && -f "$FORK" ]] || { echo "Missing required Exo/Fork hook files" >&2; exit 2; }
for symbol in 'commitPreparedSidecarSubtitle' 'expectedCurrentUrl' 'expectedGeneration' 'currentSidecarGenerationFor' 'renderSidecarCuesAtCurrentPosition'; do
    grep -q "$symbol" "$SIDE" || { echo "Missing sidecar contract: $symbol" >&2; exit 3; }
done
grep -q 'object ForkHooks' "$FORK" || { echo "ForkHooks contract not found" >&2; exit 3; }
# Fail closed: no commit of this module may touch inherited code. Checked per commit, so the
# check stays valid after the module is merged into a working branch with other history.
SCOPE=(app/src/main/java/com/nuvio/tv/fork/ai/subtitles app/src/test/java/com/nuvio/tv/fork/ai/subtitles
       tools/ai-subtitles-tests docs/agent/ai-subtitles scripts/ai-subtitles)
for commit in $(git log --no-merges --format=%H -- "${SCOPE[@]}"); do
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        case "$path" in
           app/src/main/java/com/nuvio/tv/fork/ai/subtitles/*|\
           app/src/test/java/com/nuvio/tv/fork/ai/subtitles/*|\
           tools/ai-subtitles-tests/*|\
           docs/agent/ai-subtitles/*|\
           scripts/ai-subtitles/*) ;;
           *) echo "AI-subtitles commit ${commit:0:9} touches out-of-scope file: $path" >&2; exit 5 ;;
        esac
    done < <(git diff-tree --no-commit-id --name-only -r "$commit")
done
git diff --check -- "${SCOPE[@]}"
printf 'AI-subtitles contracts present; no inherited source touched.\n'
